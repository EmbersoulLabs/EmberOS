# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails with platform superadmin access (/admin dashboard)
SUPERADMIN_EMAILS=superadmin-support@embersoullabs.com

# Billing / export (testing vs production)
# false = 1080p export open to everyone (local testing default)
# true  = 1080p gated behind paid org plans (enable at launch)
EXPORT_PAYWALL=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Vercel / serverless: use the Supabase connection pooler URL (port 6543, NOT 5432)
# with ?pgbouncer=true to enable transaction-mode pooling.
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Worker (Railway): use the direct URL (port 5432, no ?pgbouncer).
DATABASE_URL=

# Redis / Queue
REDIS_URL=redis://localhost:6379
# If you must use Upstash locally, isolate from Railway worker:
# LOCAL_DEV=true
# BULLMQ_PREFIX=local

# LLM (legacy — adapters still read this until migrated to AI Provider Config)
OPENAI_API_KEY=

########################################
# AI Runtime (Provider Environment Foundation)
# Typed config: packages/shared/src/ai-provider-env.ts
# Docs: docs/operations/ai-provider-environment.md
# Never use NEXT_PUBLIC_/VITE_ for provider secrets.
########################################

AI_PROVIDER_ROUTING_MODE=fixed

AI_DEFAULT_TEXT_PROVIDER=openai
AI_DEFAULT_VIDEO_PROVIDER=seedance
AI_DEFAULT_UPSCALE_PROVIDER=fal

AI_COST_TRACKING_ENABLED=true
AI_USAGE_LOG_ENABLED=true

# Fail-fast validated at config load (milliseconds / count)
AI_PROVIDER_TIMEOUT_MS=600000
AI_PROVIDER_MAX_RETRIES=3

########################################
# OpenAI — AI Marketing / Planning / Text
########################################

AI_PROVIDER_OPENAI_ENABLED=false
AI_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_OPENAI_API_KEY=
AI_PROVIDER_OPENAI_DEFAULT_MODEL=gpt-5.5

########################################
# BytePlus Dreamina Seedance — Video generation
########################################

AI_PROVIDER_SEEDANCE_ENABLED=false
AI_PROVIDER_SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com
AI_PROVIDER_SEEDANCE_API_KEY=
AI_PROVIDER_SEEDANCE_DEFAULT_MODEL=dreamina-seedance-2-0-260128

########################################
# MiniMax — Video generation
########################################

AI_PROVIDER_MINIMAX_ENABLED=false
AI_PROVIDER_MINIMAX_BASE_URL=
AI_PROVIDER_MINIMAX_API_KEY=
AI_PROVIDER_MINIMAX_DEFAULT_MODEL=

########################################
# fal.ai (Topaz Video Upscale) — Video upscaling
# Flux is NOT included (Creative Assets, future sprint).
########################################

AI_PROVIDER_FAL_ENABLED=false
AI_PROVIDER_FAL_BASE_URL=https://queue.fal.run
AI_PROVIDER_FAL_API_KEY=
AI_PROVIDER_FAL_DEFAULT_MODEL=fal-ai/topaz/upscale/video

# Online music library (Jamendo) — optional.
# Get a free client_id at https://devportal.jamendo.com/ to enable online BGM search.
# When unset, the in-app online search is hidden and only the built-in library is used.
JAMENDO_CLIENT_ID=

# Storage
SUPABASE_STORAGE_BUCKET=campaign-assets

# Worker
FFMPEG_PATH=ffmpeg
WORKER_CONCURRENCY=2
# Maximum wall-clock time for one vision provider request (default: 180000 / 3 minutes).
VISION_ANALYSIS_TIMEOUT_MS=180000
# FFmpeg renders are memory-heavy — keep 1 on Railway unless you have ≥2GB RAM
RENDER_CONCURRENCY=1

# Cost guardrails
LLM_BUDGET_PER_TASK_USD=0.50
CEO_MAX_RETRIES=2

# Browser E2E (Playwright marketing vertical slice)
# Setup: E2E_USER_PASSWORD=... npx tsx scripts/setup-e2e-user.ts
# Default dedicated account: e2e.marketing@local.test → E2E Company / E2E Workspace
# E2E_USER_EMAIL=e2e.marketing@local.test
# E2E_USER_PASSWORD=
# E2E_BASE_URL=http://127.0.0.1:3000
# E2E_WORKSPACE_SLUG=e2e-workspace
# Then: pnpm e2e:marketing
