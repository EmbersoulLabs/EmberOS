# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails with platform superadmin access (/admin dashboard)
SUPERADMIN_EMAILS=superadmin-support@embersoullabs.com

# Billing / export (testing vs production)
# false = 1080p export open to everyone (local testing default)
# true  = 1080p gated behind paid org plans (enable at launch)
EXPORT_PAYWALL=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Vercel / serverless: use the Supabase connection pooler URL (port 6543, NOT 5432)
# with ?pgbouncer=true to enable transaction-mode pooling.
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Worker (Railway): use the direct URL (port 5432, no ?pgbouncer).
DATABASE_URL=

# Redis / Queue
REDIS_URL=redis://localhost:6379
# If you must use Upstash locally, isolate from Railway worker:
# LOCAL_DEV=true
# BULLMQ_PREFIX=local

# LLM
OPENAI_API_KEY=

# Online music library (Jamendo) — optional.
# Get a free client_id at https://devportal.jamendo.com/ to enable online BGM search.
# When unset, the in-app online search is hidden and only the built-in library is used.
JAMENDO_CLIENT_ID=

# Storage
SUPABASE_STORAGE_BUCKET=campaign-assets

# Worker
FFMPEG_PATH=ffmpeg
WORKER_CONCURRENCY=2
# FFmpeg renders are memory-heavy — keep 1 on Railway unless you have ≥2GB RAM
RENDER_CONCURRENCY=1

# Cost guardrails
LLM_BUDGET_PER_TASK_USD=0.50
CEO_MAX_RETRIES=2

# Photo Scene V1 — background removal (worker / server-side only)
# Do not prefix these with NEXT_PUBLIC_.
PHOTO_SCENE_BACKGROUND_REMOVAL_PROVIDER=photoroom
PHOTOROOM_API_KEY=
PHOTO_SCENE_PHOTOROOM_COST_USD=0.02
PHOTO_SCENE_PROVIDER_TIMEOUT_MS=30000
PHOTO_SCENE_ALLOW_DETERMINISTIC_PROVIDER=false
# Global official scene catalog bucket (not tenant campaign-assets)
PHOTO_SCENE_OFFICIAL_BUCKET=photo-scene-official

# Photo Scene V1 production operator flags (never set true in local/dev defaults)
# PHOTO_SCENE_PROD_MIGRATION_ALLOW=false
# PHOTO_SCENE_PROD_BUCKET_ALLOW=false
# PHOTO_SCENE_PROD_SEED_ALLOW=false
# PHOTO_SCENE_PROD_MIGRATION_ACK=PHOTO_SCENE_V1
# PHOTO_SCENE_PROD_SUPABASE_REF=egkgybrjmzukzmkcrpag
