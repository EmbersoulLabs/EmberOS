{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emberos.local/schemas/hybrid-migration-intent.schema.json",
  "title": "EmberOS Hybrid Migration Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticketId", "wave", "changeKind", "reason", "sourceAuthority", "targetModule", "allowedSourcePaths", "allowedTargetPaths", "protectedDomainsExpectedToChange", "protectedDomainsMustNotChange", "requiredTests", "blueprintBaselineId"],
  "properties": {
    "ticketId": { "type": "string", "minLength": 8 },
    "wave": { "type": "integer", "minimum": 0, "maximum": 6 },
    "changeKind": { "enum": ["HYBRID_MIGRATION", "PRODUCTION_CORRECTNESS_REPAIR", "SECURITY_REPAIR", "GOVERNANCE"] },
    "reason": { "type": "string", "minLength": 12 },
    "sourceAuthority": { "enum": ["origin/main", "origin/staging", "BLUEPRINT", "SECURITY_AUDIT"] },
    "targetModule": { "type": "string", "minLength": 2 },
    "allowedSourcePaths": { "type": "array", "items": { "type": "string" } },
    "allowedTargetPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "protectedDomainsExpectedToChange": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "protectedDomainsMustNotChange": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "requiredTests": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "blueprintBaselineId": { "type": "string", "const": "EMBEROS-BLUEPRINT-V1.3-UI-AUTHORITY-2026-08-25" }
  }
}
